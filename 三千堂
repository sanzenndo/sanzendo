  .nav-toggle.is-active span:nth-child(3) {
    transform: translateY(-7px) rotate(-45deg);
  }

  .hero {
    padding: 72px 20px;
  }

  .section {
    padding: 64px 20px;
  }

  .info-row {
    flex-direction: column;
    gap: 4px;
  }

  .price-table th,
  .price-table td {
    padding: 16px 20px;
  }
}
